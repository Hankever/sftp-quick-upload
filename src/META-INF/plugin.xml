<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.gqh.sftp-quick-upload</id>
    <name>Quick SFTP Upload</name>
    <version>1.0.0</version>
    <vendor>gqh</vendor>

    <description><![CDATA[
        <p>右键选中的文件或目录，直接上传到预先配置好的服务器，支持配置多台（测试、生产等）。</p>
        <p>菜单结构：右键 → 上传到服务器 → 第一项「设置服务器信息…」，下面依次是各台服务器。</p>
        <p>只做手动上传，没有任何自动同步；密码保存在系统钥匙串中。</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <idea-version since-build="233" until-build="253.*"/>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.gqh.sftpupload.ServersState"/>
        <notificationGroup id="SftpQuickUpload" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="SftpQuickUpload.Group"
               class="com.gqh.sftpupload.UploadGroup"
               text="上传到服务器"
               description="把选中的文件上传到配置好的服务器"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
